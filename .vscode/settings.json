{
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "files.trimTrailingWhitespace": true,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "python.analysis.typeCheckingMode": "basic",
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": [],
    "github.copilot.nextEditSuggestions.allowWhitespaceOnlyChanges": true,
    "github.copilot.nextEditSuggestions.enabled": false,
    "github.copilot.nextEditSuggestions.extendedRange": true,
    "github.copilot.nextEditSuggestions.fixes": false,
    "editor.acceptSuggestionOnCommitCharacter": false,
    "editor.acceptSuggestionOnEnter": "off",
    "editor.inlineSuggest.enabled": false,
    "editor.inlineSuggest.syntaxHighlightingEnabled": false,
    "editor.screenReaderAnnounceInlineSuggestion": false,
    "editor.suggest.matchOnWordStartOnly": false,
    "editor.inlineSuggest.edits.showLongDistanceHint": false,
    "editor.inlineSuggest.experimental.emptyResponseInformation": false,
    "editor.wordBasedSuggestions": "off"
}